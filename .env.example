# --- Shared (Dev & Prod) ---
PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lv-db
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=dev-secret-please-change-me-in-production
OPENAI_API_KEY=

# Optional OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Local Development (`docker compose up -d postgres` + `npm run dev`) ---
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lv-db
BETTER_AUTH_URL=http://localhost:3000

